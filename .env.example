# Athar (v0.1) — Environment Configuration Template
# Copy to .env and fill with non-default secrets for local deployment.

APP_NAME=Athar
APP_ENV=development
ACTOR_ID=opj-benali-unauthenticated

# App Tier Ports (bound to 127.0.0.1)
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGIN=http://127.0.0.1:5173

# Data Tier: PostgreSQL + PostGIS + TimescaleDB
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=athar_db
POSTGRES_USER=athar_user
POSTGRES_PASSWORD=change_me_pg_secret

# Data Tier: Neo4j 5.20
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j_secret

# Data Tier: Redis 7.2
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_secret
